# Copy this file to .env.test and adjust values for your local Postgres test DB.
# .env.test is gitignored; do not commit real secrets.

# Test DB MUST be a database whose name ends in `_test` — resetDb() will refuse otherwise.
# Example for a Pi/remote Postgres host:
DATABASE_URL=postgresql://postgres:PASSWORD@HOST:5432/threedf_test?schema=public
PORT=3939

# Required by sessionStorage.server.ts at import time.
SESSION_SECRET=test-session-secret-do-not-use-in-prod

# Resque/Redis values are mocked in unit/integration; e2e disables the worker via DISABLE_RESQUE.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_QUEUE=3df-test
REDIS_USERNAME=
REDIS_PASSWORD=

# Microsoft Graph: client init is lazy (see app/utils/m365/client.server.ts::getClient).
# Boot does NOT require these. Set them only if a test exercises sendMail end-to-end.
# MICROSOFT_APP_TENANT_ID=
# MICROSOFT_APP_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_3DFANTASY_FROM_EMAIL=

# Team title/abbr env vars consumed by getTeamTitles().
TEAM_1_TITLE=Team One
TEAM_1_ABBR=T1
TEAM_2_TITLE=Team Two
TEAM_2_ABBR=T2
TEAM_3_TITLE=Team Three
TEAM_3_ABBR=T3
TEAM_4_TITLE=Team Four
TEAM_4_ABBR=T4
TEAM_5_TITLE=Team Five
TEAM_5_ABBR=T5
TEAM_6_TITLE=Team Six
TEAM_6_ABBR=T6
TEAM_7_TITLE=Team Seven
TEAM_7_ABBR=T7
TEAM_8_TITLE=Team Eight
TEAM_8_ABBR=T8
TEAM_9_TITLE=Team Nine
TEAM_9_ABBR=T9
